{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push origin HEAD:main)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(gh repo edit *)",
      "Bash(git tag -d *)",
      "Bash(git branch -D *)"
    ]
  }
}
